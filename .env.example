# Copy to .env (never commit it) and replace every value marked CHANGE.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=CHANGE-generate-with-python-c-"import secrets;print(secrets.token_urlsafe(64))"
DJANGO_ALLOWED_HOSTS=localhost,your-domain.example
CORS_ALLOWED_ORIGINS=https://your-domain.example
CSRF_TRUSTED_ORIGINS=https://your-domain.example
FRONTEND_URL=https://your-domain.example
# Set to false only when you test over plain HTTP on localhost. In production terminate TLS in front of nginx.
SECURE_SSL_REDIRECT=true

# Database: PostgreSQL is primary. SQLite is a fallback that must be enabled explicitly.
DB_ENGINE=postgresql
POSTGRES_DB=mebelchi
POSTGRES_USER=mebelchi
POSTGRES_PASSWORD=CHANGE
# Keep false in production: if PostgreSQL is unreachable the backend refuses to start.
# Set true only for a deliberate single-node fallback; a WARNING is logged and shown in the admin status.
DATABASE_FALLBACK_ENABLED=false
SQLITE_PATH=/app/data/db.sqlite3

# Real SMTP is required for password-reset emails in production.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=MEBELCHI AI <no-reply@your-domain.example>

WEB_PORT=80

# Optional: Google sign-in (OAuth Web client ID from console.cloud.google.com; add your site as an authorised JavaScript origin)
GOOGLE_CLIENT_ID=

# Telegram bot (optional). The same token and secret are read by the backend (notifications) and the bot process.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_API_SECRET=CHANGE-long-random-string
ADMIN_TELEGRAM_IDS=

# --- Backups (deploy/backup.sh; see docs/DEPLOYMENT.md "Backups and restore")
BACKUP_RETENTION_DAYS=14
BACKUP_KEEP_MIN=3
BACKUP_INTERVAL_SECONDS=86400
# The release step refuses to migrate an existing database unless a verified backup is at most this old.
BACKUP_MAX_AGE_MINUTES=120
# Off-host copy: a path inside the backup container that is mounted from another machine (NFS, rclone mount, ...). Empty = none.
BACKUP_OFFSITE_DIR=
BACKUP_POST_HOOK=
# Failure alerts (optional, the message never contains user data)
BACKUP_ALERT_WEBHOOK_URL=
BACKUP_ALERT_TELEGRAM_BOT_TOKEN=
BACKUP_ALERT_TELEGRAM_CHAT_ID=

# --- Audit log retention (docs/DEPLOYMENT.md "Audit log retention")
AUDIT_TABLE_WARN_MB=2048
AUDIT_ARCHIVE_AFTER_DAYS=365
# Optional read-only PostgreSQL role used by `manage.py audit_archive` (create it with deploy/sql/audit_roles.sql)
AUDIT_ARCHIVER_USER=
AUDIT_ARCHIVER_PASSWORD=
