# Copy to .env (never commit it) and replace every value marked CHANGE.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=CHANGE-generate-with-python-c-"import secrets;print(secrets.token_urlsafe(64))"
DJANGO_ALLOWED_HOSTS=localhost,your-domain.example
CORS_ALLOWED_ORIGINS=https://your-domain.example
CSRF_TRUSTED_ORIGINS=https://your-domain.example
FRONTEND_URL=https://your-domain.example
# Set to false only when you test over plain HTTP on localhost. In production terminate TLS in front of nginx.
SECURE_SSL_REDIRECT=true

POSTGRES_DB=mebelchi
POSTGRES_USER=mebelchi
POSTGRES_PASSWORD=CHANGE

# Real SMTP is required for password-reset emails in production.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=MEBELCHI AI <no-reply@your-domain.example>

WEB_PORT=80

# Optional: Google sign-in (OAuth Web client ID from console.cloud.google.com; add your site as an authorised JavaScript origin)
GOOGLE_CLIENT_ID=
