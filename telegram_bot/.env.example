# Copy to .env. Never commit real values.
TELEGRAM_BOT_TOKEN=CHANGE-from-BotFather
# Must equal TELEGRAM_BOT_API_SECRET in the backend environment. Empty disables every bot endpoint.
TELEGRAM_BOT_API_SECRET=CHANGE-long-random-string
API_BASE_URL=http://localhost:8000/api/v1
WEB_APP_URL=http://localhost:5173
# Empty = in-memory FSM storage (single process only). Set for production.
REDIS_URL=
# Comma-separated Telegram user IDs allowed to use /stats, /users, /system_status, /broadcast.
ADMIN_TELEGRAM_IDS=
BOT_RATE_LIMIT_PER_MINUTE=30
BOT_MAX_UPLOAD_MB=20
BOT_REQUEST_TIMEOUT=10
