# Copy to .env and edit. Never commit .env.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Database selection (see docs/DEPLOYMENT.md, section 8)
# DB_ENGINE: postgresql (default when POSTGRES_DB is set) or sqlite (default when it is empty)
DB_ENGINE=postgresql
DATABASE_FALLBACK_ENABLED=true   # local development only; production should use false
SQLITE_PATH=db.sqlite3
POSTGRES_DB=mebelchi
POSTGRES_USER=mebelchi
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis / Celery (eager in-process tasks when empty)
REDIS_URL=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
